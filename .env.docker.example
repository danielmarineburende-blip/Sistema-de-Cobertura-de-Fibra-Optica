# Copia este archivo como ".env" (sin más extensión) en la carpeta del proyecto.
# Docker Compose lo lee automáticamente. NO lo subas a Git.
# Si un valor contiene $, escríbelo como $$ (Docker Compose interpreta $).

PUERTO_HOST=3000

DATA_SOURCE=

MIKROWISP_DB_HOST=
MIKROWISP_DB_PORT=3306
MIKROWISP_DB_NAME=
MIKROWISP_DB_USER=
MIKROWISP_DB_PASSWORD=
MIKROWISP_DB_TYPE=mysql

RADIO_SEGURO_METROS=80
RADIO_MAXIMO_METROS=250
TERMINALES_CERCANAS=10


NOMINATIM_EMAIL=tu-correo@ejemplo.com
NOMINATIM_PAISES=do
