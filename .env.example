# Copia este archivo como .env.local y completa los valores.
# Si un valor contiene #, espacios o comillas, escríbelo entre comillas dobles.

# Correo de contacto para Nominatim (lo exige su política de uso). No es una contraseña.
NOMINATIM_EMAIL=tu-correo@ejemplo.com
NOMINATIM_PAISES=do

# Origen de los puntos de cobertura: "prueba" o "mikrowisp"
DATA_SOURCE=prueba

# Conexión a MikroWISP (usar un usuario de SOLO LECTURA)
MIKROWISP_DB_HOST=
MIKROWISP_DB_PORT=3306
MIKROWISP_DB_NAME=
MIKROWISP_DB_USER=
MIKROWISP_DB_PASSWORD=
MIKROWISP_DB_TYPE=mysql

# Niveles de cobertura (distancia en línea recta a la caja NAP más cercana, en metros)
#   hasta RADIO_SEGURO_METROS            → verde:    cobertura disponible
#   hasta RADIO_MAXIMO_METROS            → amarillo: requiere verificación técnica
#   más lejos                            → rojo:     sin cobertura registrada
RADIO_SEGURO_METROS=80
RADIO_MAXIMO_METROS=250

# Cuántas cajas cercanas se muestran en el mapa y en el listado (1 a 50)
TERMINALES_CERCANAS=10

# Segundos que se guardan en memoria las cajas leídas antes de volver a consultar MikroWISP
CACHE_PUNTOS_SEGUNDOS=60
